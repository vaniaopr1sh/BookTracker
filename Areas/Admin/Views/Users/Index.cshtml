@model AdminUsersViewModel
@{
    ViewData["Title"] = "Користувачі — адмін-панель";
}

<div class="bw-section-head">
    <div>
        <h1 class="bw-title">Користувачі</h1>
        <p class="bw-subtitle mb-0">Зареєстровано: @Model.TotalCount</p>
    </div>
</div>

<form method="get" asp-area="Admin" asp-controller="Users" asp-action="Index" class="bw-catalog-toolbar" role="search">
    <div class="row g-2">
        <div class="col-8 col-md-10">
            <label for="userSearch" class="visually-hidden">Пошук користувача</label>
            <input type="search" id="userSearch" name="search" value="@Model.Search" class="form-control" placeholder="Ім'я або email…" maxlength="100" />
        </div>
        <div class="col-4 col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">Знайти</button>
        </div>
    </div>
</form>

@if (!Model.Users.Any())
{
    <div class="bw-empty">
        <h3>Нікого не знайдено</h3>
        <p>Спробуйте інший запит.</p>
        <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-outline-bw">Показати всіх</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle bw-table mb-0">
            <thead>
                <tr>
                    <th>Користувач</th>
                    <th>Роль</th>
                    <th>На полиці</th>
                    <th>Оцінок</th>
                    <th class="text-end"><span class="visually-hidden">Дії</span></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model.Users)
            {
                <tr data-bw-user="@user.Id">
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span class="bw-avatar" aria-hidden="true">@(user.DisplayName.Length > 0 ? user.DisplayName.Substring(0, 1) : "?")</span>
                            <div>
                                <div class="fw-semibold">@user.DisplayName @if (user.IsCurrentUser) { <small class="text-secondary">(це ви)</small> }</div>
                                <div class="small text-secondary">@user.Email</div>
                            </div>
                        </div>
                    </td>
                    <td data-bw-user-roles>
                        @foreach (var role in user.Roles)
                        {
                            <span class="bw-role-badge @(role == Roles.Administrator ? "" : "bw-role-badge--user")">@role</span>
                        }
                    </td>
                    <td>@user.ShelfCount</td>
                    <td>@user.RatingsCount</td>
                    <td class="text-end">
                        @if (user.IsCurrentUser)
                        {
                            <span class="small text-secondary">—</span>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm @(user.IsAdmin ? "btn-outline-danger" : "btn-outline-bw")"
                                    data-bw-role-toggle data-user-id="@user.Id" data-name="@user.DisplayName"
                                    data-make-admin="@(user.IsAdmin ? "false" : "true")">
                                @(user.IsAdmin ? "Забрати права адміна" : "Зробити адміном")
                            </button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
