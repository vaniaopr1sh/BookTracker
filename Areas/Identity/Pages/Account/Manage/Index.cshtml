@page
@model IndexModel
@{
    ViewData["Title"] = "Контактні дані";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h2 class="h4 mb-3">@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="profile-form" method="post" class="bw-narrow-form">
    <div asp-validation-summary="ModelOnly" class="bw-auth-alert" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Username" class="form-label">Email (логін)</label>
        <input asp-for="Username" class="form-control" disabled />
    </div>
    <div class="mb-4">
        <label asp-for="Input.PhoneNumber" class="form-label"></label>
        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+380 XX XXX XX XX" autocomplete="tel" />
        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
    </div>
    <button id="update-profile-button" type="submit" class="btn btn-primary" data-loading-text="Зберігаємо…">Зберегти</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
