@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";
    }
}

<div class="bw-section-head">
    <div>
        <h1 class="bw-title">Налаштування облікового запису</h1>
        <p class="bw-subtitle mb-0">Контактні дані та безпека входу</p>
    </div>
    <a asp-area="" asp-controller="Profile" asp-action="Index" class="btn btn-outline-bw">&larr; До кабінету</a>
</div>

<div class="row g-4">
    <div class="col-md-4 col-lg-3">
        <partial name="_ManageNav" />
    </div>
    <div class="col-md-8 col-lg-9">
        <div class="bw-form-card">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
