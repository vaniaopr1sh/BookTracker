@page
@model RegisterModel
@{
    ViewData["Title"] = "Реєстрація";
}
@* Резервна сторінка реєстрації (без JavaScript). Основний сценарій — popup на будь-якій сторінці порталу. *@

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="bw-form-card">
            <div class="text-center mb-3">
                <img src="~/img/logo.png" alt="" width="90" />
                <h1 class="h3 mt-2">Створити обліковий запис</h1>
            </div>
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="bw-auth-alert" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.DisplayName" class="form-label">Ім'я</label>
                    <input asp-for="Input.DisplayName" class="form-control" aria-required="true" placeholder="Як до вас звертатися?" />
                    <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Пароль</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Щонайменше 6 символів" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Повторіть пароль</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Ще раз пароль" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Зареєструватися</button>
                <p class="bw-auth-hint text-center mt-3 mb-0">
                    Вже маєте обліковий запис? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Увійти</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
