@model BookTracker.ViewModels.StatusCodeViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="bw-message-page">
    <div class="bw-code">@Model.Code</div>
    <img src="~/img/alata.jpg" alt="Книжкова фея Алата" width="110" height="110" class="rounded-circle my-3" style="object-fit: cover; box-shadow: 0 0 0 6px var(--bw-sand)" />
    <h1 class="h3">@Model.Title</h1>
    <p class="text-secondary">@Model.Message</p>
    <div class="d-flex gap-2 justify-content-center flex-wrap">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">На головну</a>
        <a asp-controller="Books" asp-action="Index" class="btn btn-outline-bw">До каталогу</a>
    </div>
</div>
