@model ErrorViewModel
@{
    ViewData["Title"] = "Помилка";
}

<h1 class="text-danger">Помилка</h1>
<h2 class="text-danger">Під час обробки запиту сталася помилка.</h2>
<p>Спробуйте повторити дію пізніше. Якщо помилка повторюється, повідомте адміністратора.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Ідентифікатор запиту:</strong> <code>@Model.RequestId</code>
    </p>
}

<p><a asp-controller="Home" asp-action="Index">На головну</a></p>
