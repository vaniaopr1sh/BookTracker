@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var appUser = await UserManager.GetUserAsync(User);
    var displayName = !string.IsNullOrWhiteSpace(appUser?.DisplayName) ? appUser!.DisplayName! : User.Identity!.Name ?? "Читач";
    var isAdmin = User.IsInRole(Roles.Administrator);

    <div class="dropdown">
        <a href="#" class="bw-user-chip dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false" id="bwUserMenu">
            <span class="bw-avatar" aria-hidden="true">@displayName.Substring(0, 1)</span>
            <span data-bw-user-name>@displayName</span>
            @if (isAdmin)
            {
                <span class="bw-role-badge">адмін</span>
            }
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="bwUserMenu">
            <li><h6 class="dropdown-header">@User.Identity!.Name</h6></li>
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Мій профіль</a></li>
            @if (isAdmin)
            {
                <li><a class="dropdown-item" asp-area="" asp-controller="Books" asp-action="Index">Керування каталогом</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="Books" asp-action="Create">Додати книгу</a></li>
            }
            else
            {
                <li><a class="dropdown-item" asp-area="" asp-controller="MyBooks" asp-action="Index">Мої книги</a></li>
            }
            <li><hr class="dropdown-divider" /></li>
            <li>
                @* Без JS форма працює як звичайний вихід; з JS — auth.js також очищає JWT *@
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" data-bw-logout>
                    <button type="submit" class="dropdown-item text-danger">Вийти</button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="d-flex gap-2">
        <a class="btn btn-outline-bw btn-sm" asp-area="Identity" asp-page="/Account/Login" data-bw-auth="login">Увійти</a>
        <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register" data-bw-auth="register">Реєстрація</a>
    </div>
}
