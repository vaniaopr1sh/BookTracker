@model List<BookTracker.ViewModels.MyBookItemViewModel>
@{
    ViewData["Title"] = "Мої книги";
}

<div class="bw-section-head">
    <div>
        <h1 class="bw-title">Моя полиця</h1>
        <p class="bw-subtitle mb-0">Книги, які ви читаєте, прочитали або плануєте прочитати</p>
    </div>
    <a asp-controller="Books" asp-action="Index" class="btn btn-outline-bw">+ Знайти ще книги</a>
</div>

@if (!Model.Any())
{
    <div class="bw-empty">
        <img src="~/img/alata.jpg" alt="Книжкова фея Алата" />
        <h3>Ваша полиця поки порожня</h3>
        <p>Алата вже підготувала для вас кілька чудових історій. Загляньте до каталогу та додайте першу книгу!</p>
        <a asp-controller="Books" asp-action="Index" class="btn btn-primary">Перейти до каталогу</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle bw-table mb-0">
            <thead>
                <tr>
                    <th>Книга</th>
                    <th>Статус</th>
                    <th>Моя оцінка</th>
                    <th class="text-end"><span class="visually-hidden">Дії</span></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@item.UserBook.BookId" class="fw-semibold text-decoration-none">@item.UserBook.Book!.Title</a>
                        <div class="small text-secondary">@item.UserBook.Book!.Author</div>
                    </td>
                    <td>
                        <form method="post" asp-action="UpdateStatus">
                            <input type="hidden" name="userBookId" value="@item.UserBook.Id" />
                            <select name="status" class="form-select form-select-sm w-auto" onchange="this.form.submit()" aria-label="Статус читання">
                                @foreach (ReadingStatus s in Enum.GetValues(typeof(ReadingStatus)))
                                {
                                    <option value="@s" selected="@(item.UserBook.Status == s)">@s.GetDisplayName()</option>
                                }
                            </select>
                        </form>
                    </td>
                    <td>
                        <form method="post" asp-action="Rate">
                            <input type="hidden" name="bookId" value="@item.UserBook.BookId" />
                            <select name="value" class="form-select form-select-sm w-auto" onchange="this.form.submit()" aria-label="Моя оцінка">
                                <option value="">—</option>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <option value="@i" selected="@(item.MyRating == i)">@(new string('★', i))</option>
                                }
                            </select>
                        </form>
                    </td>
                    <td class="text-end">
                        <form method="post" asp-action="Remove" data-bw-confirm="Прибрати «@item.UserBook.Book!.Title» з вашої полиці?">
                            <input type="hidden" name="userBookId" value="@item.UserBook.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Прибрати</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
