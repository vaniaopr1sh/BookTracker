@model BookTracker.ViewModels.CatalogViewModel
@using BookTracker.ViewModels
@{
    ViewData["Title"] = "Каталог книг";
    var isAdmin = User.IsInRole(Roles.Administrator);
}

<div class="bw-section-head">
    <div>
        <h1 class="bw-title">Каталог книг</h1>
        <p class="bw-subtitle mb-0">Знайдіть історію, яка подарує вам крила</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            Додати книгу
        </a>
    }
</div>

<form method="get" asp-action="Index" class="bw-catalog-toolbar" id="bwCatalogFilters" role="search">
    <div class="row g-2 align-items-center">
        <div class="col-md-7 col-lg-8">
            <label for="bwSearch" class="visually-hidden">Пошук</label>
            <div class="bw-input-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input type="search" id="bwSearch" name="search" value="@Model.Search" class="form-control"
                       placeholder="Пошук за назвою або автором…" autocomplete="off" maxlength="100" />
            </div>
        </div>
        <div class="col-8 col-md-3 col-lg-3">
            <label for="bwSort" class="visually-hidden">Сортування</label>
            <select id="bwSort" name="sort" class="form-select">
                @foreach (var option in CatalogSort.Options)
                {
                    <option value="@option.Key" selected="@(Model.Sort == option.Key)">@option.Value</option>
                }
            </select>
        </div>
        <div class="col-4 col-md-2 col-lg-1 d-grid">
            <button type="submit" class="btn btn-primary" data-bw-nojs-submit>Знайти</button>
        </div>
    </div>
    <input type="hidden" name="genre" value="@Model.Genre" id="bwGenre" />
</form>

@if (Model.Genres.Any())
{
    <div class="bw-genre-chips" role="group" aria-label="Фільтр за жанром">
        <a asp-action="Index" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort"
           class="bw-chip @(string.IsNullOrEmpty(Model.Genre) ? "active" : "")" data-bw-genre="">Усі жанри</a>
        @foreach (var genre in Model.Genres)
        {
            <a asp-action="Index" asp-route-genre="@genre" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort"
               class="bw-chip @(Model.Genre == genre ? "active" : "")" data-bw-genre="@genre">@genre</a>
        }
    </div>
}

<div class="bw-grid-wrapper" id="bwCatalogResults" aria-live="polite" aria-busy="false">
    <partial name="_BookGrid" model="Model" />
</div>

<template id="bwSkeletonTemplate">
    <div class="bw-grid">
        @for (var i = 0; i < 8; i++)
        {
            <div class="bw-skeleton" aria-hidden="true">
                <div class="bw-skeleton-cover"></div>
                <div class="bw-skeleton-line"></div>
                <div class="bw-skeleton-line short"></div>
            </div>
        }
    </div>
</template>

@section Scripts {
    <script src="~/js/catalog.js" asp-append-version="true"></script>
}
