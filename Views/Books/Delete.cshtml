@model Book
@{
    ViewData["Title"] = "Видалення книги";
}
@* Резервна сторінка підтвердження (якщо JavaScript вимкнено). Зазвичай видалення відбувається через popup-підтвердження. *@

<div class="bw-message-page">
    <div class="bw-panel">
        <div class="row g-4 align-items-center text-start">
            <div class="col-sm-4">
                <div class="bw-details-cover">
                    <partial name="_BookCover" model="Model" />
                </div>
            </div>
            <div class="col-sm-8">
                <h1 class="h3 mb-2">Видалити книгу?</h1>
                <p class="mb-1"><strong>@Model.Title</strong></p>
                <p class="text-secondary">@Model.Author</p>
                <p class="small">Книгу буде остаточно видалено з каталогу разом з оцінками та записами читачів. Цю дію не можна скасувати.</p>
                <form asp-action="Delete" method="post" class="d-flex gap-2 flex-wrap">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Так, видалити</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-bw">Скасувати</a>
                </form>
            </div>
        </div>
    </div>
</div>
