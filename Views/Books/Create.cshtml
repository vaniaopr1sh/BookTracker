@model Book
@{
    ViewData["Title"] = "Нова книга";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb bw-breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Каталог</a></li>
        <li class="breadcrumb-item active" aria-current="page">Нова книга</li>
    </ol>
</nav>

<h1 class="bw-title">Нова книга</h1>
<p class="bw-subtitle">Заповніть інформацію про видання — поля з <span class="text-danger">*</span> обов'язкові</p>

<partial name="_BookForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/book-form.js" asp-append-version="true"></script>
}
